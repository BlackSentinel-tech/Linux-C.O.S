#!/bin/sh
# Linux-C.O.S -- drops you into the BlackArch container: BlackArch's tools
# running natively (real pacman-built Arch binaries, not emulated), with
# your home directory bind-mounted so files you touch there are the same
# files you see from the Debian side.
#
# Which image you get depends on how the ISO was built (see
# docs/BLACKARCH-INTEGRATION.md): the full `blackarch` group baked in at
# build time, or BlackArch's official base image pulled on first boot, in
# which case install what you need inside with `pacman -S <tool>` (or
# `pacman -S blackarch` for everything -- tens of GB).
set -e

IMG=linux-cos/blackarch:latest
UPSTREAM=blackarchlinux/blackarch:latest
NAME=blackarch-tools

usage() {
  cat <<'EOF'
blackarch-shell -- open a shell with BlackArch's tools (Docker container)

usage:
  blackarch-shell             open (or re-join) the BlackArch shell
  blackarch-shell <command>   run one command inside it, e.g. blackarch-shell nmap -h
  blackarch-shell --update    pull the latest BlackArch image
  blackarch-shell --status    show whether the image is present / running
  blackarch-shell --help      this text

Your home directory is mounted at the same path inside the container.
Inside: `pacman -Ss <name>` searches tools, `pacman -S <name>` installs one.
EOF
}

docker_cmd() {
  if [ -w /var/run/docker.sock ] || [ "$(id -u)" -eq 0 ]; then
    docker "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo docker "$@"
  else
    docker "$@"
  fi
}

need_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "blackarch-shell: docker is not installed -- run: sudo apt install docker.io" >&2
    exit 1
  fi
  if ! docker_cmd info >/dev/null 2>&1; then
    echo "blackarch-shell: the Docker daemon is not running -- start it with: sudo systemctl start docker" >&2
    exit 1
  fi
}

case "${1:-}" in
  -h|--help|help)
    usage; exit 0 ;;
  --update)
    need_docker
    echo "Pulling $UPSTREAM (this can take a while on the first run)..."
    docker_cmd pull "$UPSTREAM"
    docker_cmd tag "$UPSTREAM" "$IMG"
    echo "Done. Run: blackarch-shell"
    exit 0 ;;
  --status)
    need_docker
    if docker_cmd image inspect "$IMG" >/dev/null 2>&1; then
      echo "image:     present ($IMG)"
    else
      echo "image:     missing -- run: blackarch-shell --update"
    fi
    if docker_cmd ps --format '{{.Names}}' | grep -qx "$NAME"; then
      echo "container: running ($NAME)"
    else
      echo "container: not running"
    fi
    exit 0 ;;
  -*)
    echo "blackarch-shell: unknown option '$1'" >&2
    usage >&2
    exit 1 ;;
esac

need_docker

if ! docker_cmd image inspect "$IMG" >/dev/null 2>&1; then
  echo "The BlackArch image is not on this machine yet."
  if systemctl is-active --quiet linux-cos-blackarch-pull.service 2>/dev/null; then
    echo "It is still downloading in the background -- follow it with:"
    echo "  journalctl -fu linux-cos-blackarch-pull"
  else
    echo "Download it now with:  blackarch-shell --update"
  fi
  exit 1
fi

# -t only when we really have a terminal, so `blackarch-shell nmap -h | less`
# and scripts work too.
if [ -t 0 ] && [ -t 1 ]; then TTY=-it; else TTY=-i; fi

if [ $# -eq 0 ]; then set -- zsh; fi

if docker_cmd ps --format '{{.Names}}' | grep -qx "$NAME"; then
  docker_cmd exec "$TTY" -w "$HOME" "$NAME" "$@"
  exit $?
fi

docker_cmd run "$TTY" --rm \
  --name "$NAME" \
  --hostname blackarch \
  --network host \
  --cap-add NET_RAW --cap-add NET_ADMIN \
  -v "$HOME:$HOME" \
  -w "$HOME" \
  "$IMG" "$@"
