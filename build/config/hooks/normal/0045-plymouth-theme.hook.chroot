#!/bin/sh
# Linux-C.O.S build hook -- boot splash. Writing a Plymouth theme from
# scratch (a real animation engine, "script") is a project on its own;
# every practical custom-distro does the same thing we're doing here
# instead: clone a solid stock theme (`spinner`, ships in plymouth-themes,
# already in desktop-xfce.list.chroot) and swap its watermark for our logo.
set -e

SRC=/usr/share/plymouth/themes/spinner
DST=/usr/share/plymouth/themes/linux-cos

if [ ! -d "$SRC" ]; then
  echo "[linux-cos] WARNING: spinner plymouth theme not found, skipping boot splash branding"
  exit 0
fi

echo "[linux-cos] building the linux-cos plymouth theme from spinner"
cp -r "$SRC" "$DST"
mv "$DST/spinner.plymouth" "$DST/linux-cos.plymouth"
mv "$DST/spinner.script" "$DST/linux-cos.script" 2>/dev/null || true

sed -i \
  -e 's/^Name=.*/Name=Linux-C.O.S/' \
  -e 's/^Description=.*/Description=Linux-C.O.S boot splash/' \
  -e 's/ImageDir=.*/ImageDir=\/usr\/share\/plymouth\/themes\/linux-cos/' \
  -e 's/ScriptFile=.*/ScriptFile=\/usr\/share\/plymouth\/themes\/linux-cos\/linux-cos.script/' \
  "$DST/linux-cos.plymouth"

cp /usr/share/backgrounds/linux-cos/logo.png "$DST/watermark.png"
# Background: near-black navy to match the wallpaper and lightdm, instead of
# spinner's default. `spinner` is a two-step theme -- its colors live in the
# [two-step] section of the .plymouth file, not in a .script (an earlier
# version of this hook sed'ed a .script file spinner doesn't ship, so the
# color change silently never applied).
set_twostep() { # set_twostep <key> <value>
  if grep -q "^$1=" "$DST/linux-cos.plymouth"; then
    sed -i "s|^$1=.*|$1=$2|" "$DST/linux-cos.plymouth"
  else
    sed -i "/^\[[Tt]wo-[Ss]tep\]/a $1=$2" "$DST/linux-cos.plymouth"
  fi
}
set_twostep BackgroundStartColor 0x0a0f24
set_twostep BackgroundEndColor 0x05070d
set_twostep WatermarkHorizontalAlignment .5
set_twostep WatermarkVerticalAlignment .42

plymouth-set-default-theme -R linux-cos
