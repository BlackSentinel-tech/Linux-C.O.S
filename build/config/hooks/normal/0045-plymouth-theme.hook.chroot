#!/bin/sh
# Linux-C.O.S build hook -- boot splash. A real animated theme: the stock
# `spinner` two-step theme (it ships the password-prompt artwork LUKS needs)
# with its throbber frames replaced by ours -- a neon ring that rotates around
# the shield (rendered by scripts/render-cos-assets.py, 72 frames).
set -e

SRC=/usr/share/plymouth/themes/spinner
DST=/usr/share/plymouth/themes/linux-cos
ART=/usr/share/linux-cos/plymouth

if [ ! -d "$SRC" ] || [ ! -f "$ART/throbber-0001.png" ]; then
  echo "[linux-cos] WARNING: plymouth spinner theme or COS artwork missing, skipping boot splash"
  exit 0
fi

echo "[linux-cos] building the linux-cos plymouth theme"
rm -rf "$DST"
cp -r "$SRC" "$DST"
rm -f "$DST"/throbber-*.png "$DST"/animation-*.png
cp "$ART"/throbber-*.png "$ART/watermark.png" "$DST/"
mv "$DST/spinner.plymouth" "$DST/linux-cos.plymouth"
rm -f "$DST/spinner.script"

sed -i \
  -e 's/^Name=.*/Name=Linux-C.O.S/' \
  -e 's/^Description=.*/Description=Linux-C.O.S animated boot splash/' \
  -e 's|^ImageDir=.*|ImageDir=/usr/share/plymouth/themes/linux-cos|' \
  -e 's|^ScriptFile=.*|ScriptFile=/usr/share/plymouth/themes/linux-cos/linux-cos.script|' \
  "$DST/linux-cos.plymouth"
# the translated Name[xx]= lines still say "Spinner"
sed -i '/^Name\[/d' "$DST/linux-cos.plymouth"

set_twostep() { # set_twostep <key> <value>
  if grep -q "^$1=" "$DST/linux-cos.plymouth"; then
    sed -i "s|^$1=.*|$1=$2|" "$DST/linux-cos.plymouth"
  else
    sed -i "/^\[[Tt]wo-[Ss]tep\]/a $1=$2" "$DST/linux-cos.plymouth"
  fi
}
set_twostep BackgroundStartColor 0x0b1020
set_twostep BackgroundEndColor 0x02030a
set_twostep HorizontalAlignment .5
set_twostep VerticalAlignment .45
set_twostep WatermarkHorizontalAlignment .5
set_twostep WatermarkVerticalAlignment .45
set_twostep ProgressBarBackgroundColor 0x1c2a52
set_twostep ProgressBarForegroundColor 0x00e5ff
set_twostep MessageBelowAnimation true

plymouth-set-default-theme -R linux-cos
