# Linux-C.O.S: kill the runaway process, not the desktop. Fires when free RAM
# AND swap are both under 5%.
EARLYOOM_ARGS="-r 3600 -m 5 -s 5 --avoid '(^|/)(Xorg|xfwm4|xfce4-session|xfce4-panel|picom|systemd|sshd|NetworkManager)$' --prefer '(^|/)(java|burpsuite|zaproxy|chromium|firefox-esr|hashcat|john)$'"
