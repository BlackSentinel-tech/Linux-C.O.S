[Unit]
Description=Linux-C.O.S: set the live session kali user's password
# live-config.service is what actually creates the "kali" account (from
# username=kali on the kernel cmdline) -- we have to run strictly after it,
# every boot, since the live filesystem (and that account) resets each time.
After=live-config.service
Wants=live-config.service
ConditionPathExists=/run/live

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/linux-cos-live-password
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
