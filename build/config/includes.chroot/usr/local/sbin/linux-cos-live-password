#!/bin/sh
# Linux-C.O.S -- live-config creates the live session's "kali" user fresh
# on every single boot (username=kali, see auto/config's --bootappend-live)
# with no usable password, and lightdm's PAM stack refuses a blank one at
# the graphical greeter. Give it a real, documented one -- kali/kali, the
# same convention Kali's own live images use -- every boot, not just the
# first (there's no persistent state to remember "already set" across
# live-session boots the way there is on an installed system).
set -e
if id kali >/dev/null 2>&1; then
  echo "kali:kali" | chpasswd
  # zsh is the Linux-C.O.S shell (prompt, plugins and the BlackArch
  # command-not-found hook live in its ~/.zshrc); live-config creates the
  # account with bash.
  if [ -x /usr/bin/zsh ]; then usermod -s /usr/bin/zsh kali || true; fi
fi
